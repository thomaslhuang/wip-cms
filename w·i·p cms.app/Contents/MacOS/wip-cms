#!/bin/bash
# w·i·p cms for Mac: double-click to start the editor and open it in its own window.
#
#   1. finds the wip-cms folder (the one this app sits in, or the last one used)
#   2. finds Node.js (Homebrew, the installer from nodejs.org, nvm, Volta...)
#   3. installs or updates its packages when needed (first launch, or after a pull)
#   4. starts the editor in the background, unless it's already running; if you've pulled
#      a newer version since it started, it restarts it
#   5. opens it in your default browser
#
# Anything it prints goes to ~/Library/Logs/wip cms.log. Quit the editor from its ⋯ menu.

PORT="${WIP_PORT:-4321}"
URL="http://localhost:$PORT"
SUPPORT="$HOME/Library/Application Support/wip cms"
LOG="$HOME/Library/Logs/wip cms.log"
mkdir -p "$SUPPORT" "$(dirname "$LOG")"
say() { osascript -e "display notification \"$1\" with title \"w·i·p cms\"" >/dev/null 2>&1; }
alert() { osascript -e "display dialog \"$1\" with title \"w·i·p cms\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1; }

# ---------- 1. the wip-cms folder ----------
APP="$(cd "$(dirname "$0")/../.." && pwd)"
if [ -f "$APP/../server.js" ]; then
  ROOT="$(cd "$APP/.." && pwd)"
elif [ -f "$SUPPORT/folder" ] && [ -f "$(cat "$SUPPORT/folder")/server.js" ]; then
  ROOT="$(cat "$SUPPORT/folder")"
else
  ROOT="$(osascript -e 'POSIX path of (choose folder with prompt "Where is the wip-cms folder? (the one with server.js in it)")' 2>/dev/null)" || exit 0
  ROOT="${ROOT%/}"
  [ -f "$ROOT/server.js" ] || { alert "That folder doesn't have w·i·p cms in it (no server.js)."; exit 1; }
fi
echo "$ROOT" > "$SUPPORT/folder"

# ---------- 2. Node.js ----------
# Every Node.js on this Mac (the one your Terminal uses first, then Homebrew, the installer from
# nodejs.org, Volta, asdf, nvm, fnm), and the newest of them is used: a Mac can have an old
# one lying around in /usr/local, and Eleventy (the live preview) needs Node 18 or newer.
node_candidates() {
  /bin/zsh -lic 'command -v node' 2>/dev/null | tail -1
  for n in /opt/homebrew/bin/node /usr/local/bin/node "$HOME/.volta/bin/node" "$HOME/.asdf/shims/node"; do echo "$n"; done
  for d in "$HOME/.nvm/versions/node" "$HOME/.local/share/fnm/node-versions" "$HOME/Library/Application Support/fnm/node-versions"; do
    [ -d "$d" ] || continue
    for v in "$d"/*/; do echo "${v}bin/node"; echo "${v}installation/bin/node"; done
  done
}
find_node() {
  best=""; best_major=0
  while IFS= read -r n; do
    [ -n "$n" ] && [ -x "$n" ] || continue
    major="$("$n" -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
    [ -n "$major" ] || continue
    if [ "$major" -gt "$best_major" ]; then best="$n"; best_major="$major"; fi
  done < <(node_candidates)
  echo "$best"
}
NODE="$(find_node)"
if [ -z "$NODE" ]; then
  if osascript -e 'button returned of (display dialog "w·i·p cms needs Node.js, which isn’t installed yet. Download it from nodejs.org (choose the LTS version), install it, then open w·i·p cms again." with title "w·i·p cms" buttons {"Cancel", "Get Node.js"} default button 2)' 2>/dev/null | grep -q "Get"; then
    open "https://nodejs.org/en/download"
  fi
  exit 1
fi
NODE_MAJOR="$("$NODE" -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
echo "--- $(date) using Node $("$NODE" -v) at $NODE" >> "$LOG"
if [ "${NODE_MAJOR:-0}" -lt 18 ]; then
  if osascript -e "button returned of (display dialog \"w·i·p cms found Node.js $("$NODE" -v), which is too old for the live preview (it needs version 18 or newer). Download the LTS version from nodejs.org, install it, then open w·i·p cms again.\" with title \"w·i·p cms\" buttons {\"Open anyway\", \"Get Node.js\"} default button 2)" 2>/dev/null | grep -q "Get"; then
    open "https://nodejs.org/en/download"
    exit 1
  fi
fi
# programs started from Finder get a very short PATH: add Node's folder (and the usual ones)
export PATH="$(dirname "$NODE"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
cd "$ROOT" || exit 1

# ---------- 3. packages ----------
if [ ! -d node_modules ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
  say "Getting things ready (only after an update)…"
  if ! npm install --no-audit --no-fund >> "$LOG" 2>&1; then
    alert "Couldn't install what w·i·p cms needs. Is this Mac online? Details are in ~/Library/Logs/wip cms.log."
    exit 1
  fi
fi

# ---------- 4. the editor ----------
VERSION="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
RUNNING="$(curl -s --max-time 1 "$URL/api/version" 2>/dev/null)"
if [ -n "$RUNNING" ] && ! echo "$RUNNING" | grep -q "$VERSION"; then
  # an older version is running (you've pulled since): restart it
  curl -s --max-time 2 -X POST "$URL/api/quit" >/dev/null 2>&1
  sleep 1
  RUNNING=""
fi
if [ -z "$RUNNING" ]; then
  echo "--- $(date) starting w·i·p cms from $ROOT" >> "$LOG"
  nohup "$NODE" server.js >> "$LOG" 2>&1 &
  for i in $(seq 1 60); do
    curl -s -o /dev/null --max-time 1 "$URL/api/site" && break
    sleep 0.25
  done
fi

# ---------- 5. its window ----------
# (in your default browser, as a tab like any other site)
open "$URL"
